<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .forgot-container {
      width: 100%;
      max-width: 430px;
      background: #ffffff;
      border-radius: 18px;
      padding: 34px;
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
      border: 1px solid #e5e7eb;
    }

    .logo-box {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: #4f46e5;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 22px;
    }

    h2 {
      font-size: 26px;
      color: #111827;
      margin-bottom: 8px;
    }

    .subtitle {
      color: #6b7280;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 26px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #d1d5db;
      border-radius: 12px;
      font-size: 15px;
      outline: none;
      transition: 0.2s ease;
      background: #f9fafb;
    }

    input:focus {
      border-color: #4f46e5;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: #4f46e5;
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s ease;
    }

    button:hover {
      background: #4338ca;
      transform: translateY(-1px);
    }

    .footer-text {
      text-align: center;
      margin-top: 22px;
      font-size: 14px;
      color: #6b7280;
    }

    .footer-text a {
      color: #4f46e5;
      font-weight: 700;
      text-decoration: none;
    }

    .footer-text a:hover {
      text-decoration: underline;
    }

    .back-login {
      text-align: center;
      margin-top: 14px;
    }

    .back-login a {
      font-size: 14px;
      color: #374151;
      text-decoration: none;
    }

    .back-login a:hover {
      color: #4f46e5;
    }
  </style>
</head>

<body>
  <div class="forgot-container">
    <div class="logo-box">🔐</div>

    <h2>Forgot Password?</h2>

    <p class="subtitle">
      No worries. Enter your registered email address and we will send you a
      password reset link or OTP.
    </p>

    <!-- 
  Form action me jo path diya hai, wo current server/domain ke root se attach hota hai.
  Example: agar server http://localhost:3000 par running hai,
  aur action="/auth/forgot-password" hai,
  to request jayegi: http://localhost:3000/auth/forgot-password
-->
    <form action="/api/auth/forgot-password" method="POST">
      <div class="form-group">
        <label for="email">Email Address</label>

        <input id="email" type="email" name="email" placeholder="Enter your email" required />
      </div>

      <button type="submit">Send Reset Link</button>
    </form>

    <p class="footer-text">
      New user?
      <a href="/api/auth/registerPage">Register here</a>
    </p>

    <!-- <div class="back-login">
        <a href="/api/auth/login">← Back to login</a>
      </div> -->
  </div>
</body>

</html>